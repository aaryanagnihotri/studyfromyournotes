# Local demo is the default and requires no Azure credentials.
# Change this to azure only after provisioning/configuring Azure resources.
APP_MODE=demo
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_KEY=<search-admin-or-indexer-key>
AZURE_SEARCH_INDEX=document-qa-chunks
AZURE_STORAGE_CONNECTION_STRING=<storage-connection-string>
AZURE_STORAGE_CONTAINER=course-notes
FOUNDRY_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
FOUNDRY_API_KEY=<foundry-model-api-key>
FOUNDRY_CHAT_DEPLOYMENT=<your-chat-model-deployment-name>
FOUNDRY_API_VERSION=2024-10-21
